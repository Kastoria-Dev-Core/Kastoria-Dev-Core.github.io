---
import type { NetworkMap } from "../lib/network";

interface Props {
  map: NetworkMap;
  label: string;
}
const { map, label } = Astro.props;
---

<figure class="network">
  <svg
    class="draw h-auto w-full overflow-hidden rounded-lg bg-navy-deep/60 ring-1 ring-white/10"
    viewBox={`0 0 ${map.width} ${map.height}`}
    role="img"
    aria-label={label}
    data-network
  >
    {
      map.lines.flatMap((line, i) => line.parts.map((d) => (
        <path
          class="route transition-opacity duration-200"
          data-line={line.id}
          d={d}
          pathLength="1"
          fill="none"
          stroke={line.color}
          stroke-width="4.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          style={`animation-delay:${i * 90}ms`}
        />
      )))
    }
    <g fill="#f4f1ea" fill-opacity="0.85">
      {map.stops.map(([x, y]) => <circle cx={x} cy={y} r="2.4" />)}
    </g>
  </svg>
  <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Lines">
    {
      map.lines.map((line) => (
        <li>
          <button
            type="button"
            class="font-mono text-[11px] leading-none font-semibold rounded-[5px] px-1.5 py-1 text-white/90 ring-1 ring-white/15 hover:ring-white/60 focus-visible:ring-white"
            style={`background:${line.color}`}
            data-chip={line.id}
            title={line.name.el}
          >
            {line.number.padStart(2, "0")}
          </button>
        </li>
      ))
    }
  </ul>
</figure>

<script>
  // Point at a line number to see that line alone on the map
  const svg = document.querySelector<SVGSVGElement>("[data-network]");
  const routes = svg ? Array.from(svg.querySelectorAll<SVGPathElement>("path.route")) : [];
  const show = (id: string | null) => {
    for (const r of routes) r.style.opacity = id && r.dataset.line !== id ? "0.12" : "1";
  };
  for (const chip of document.querySelectorAll<HTMLButtonElement>("[data-chip]")) {
    chip.addEventListener("mouseenter", () => show(chip.dataset.chip ?? null));
    chip.addEventListener("focus", () => show(chip.dataset.chip ?? null));
    chip.addEventListener("mouseleave", () => show(null));
    chip.addEventListener("blur", () => show(null));
  }
</script>
