---
import Base from "../layouts/Base.astro";
import NetworkMap from "./NetworkMap.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import { t, type Lang } from "../lib/i18n";
import { loadNetwork } from "../lib/network";
import { latestRelease, recentActivity } from "../lib/github";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t[lang];

// Everything below is read once, when the site is built (daily on CI)
const [network, androidRelease, iosRelease, uniCalendarRelease, activity] = await Promise.all([
  loadNetwork(),
  latestRelease("astiko-ktel-kastorias-app"),
  latestRelease("astiko-ktel-kastorias-ios"),
  latestRelease("UniCalendar"),
  recentActivity(8, ["astiko-ktel-live", "astiko-ktel-odigoi"]),
]);

const gh = "https://github.com/Kastoria-Dev-Core";
const pages = "https://kastoria-dev-core.github.io";
const date = (iso: string) =>
  new Date(iso).toLocaleDateString(s.dateLocale, { day: "numeric", month: "short", year: "numeric", timeZone: "Europe/Athens" });
const shortDate = (iso: string) =>
  new Date(iso).toLocaleDateString(s.dateLocale, { day: "2-digit", month: "2-digit", timeZone: "Europe/Athens" });

// The buses app is one app on two platforms: one block, a row for each
// and the cron job that feeds it the operator's announcements is part of it too
const platforms = [
  { label: "Android", repo: "astiko-ktel-kastorias-app", docs: `${pages}/astiko-ktel-kastorias-app/`, release: androidRelease, note: null },
  { label: "iOS", repo: "astiko-ktel-kastorias-ios", docs: `${pages}/astiko-ktel-kastorias-ios/`, release: iosRelease, note: null },
  { label: s.buses.announcements, repo: "astiko-ktel-announcements", docs: null, release: null, note: s.buses.announcementsNote },
];

const others = [
  { key: "unicalendar", icon: "/icon-unicalendar.png", tech: "Kotlin · Jetpack Compose", repo: "UniCalendar", release: uniCalendarRelease },
] as const;

const team = [
  { el: "Ιωάννης Μιχαδάσης", en: "Ioannis Michadasis", login: "michadasis" },
  { el: "Γιώργος Γάσπαρης", en: "Giorgos Gasparis", login: "GasparisGiorgos" },
  { el: "Κωνσταντίνος Θεολόγου", en: "Konstantinos Theologou", login: "the0099" },
];

// Straight from the apps' repos, where CI keeps them up to date with each change to the screens
const raw = (repo: string, file: string) =>
  `https://raw.githubusercontent.com/Kastoria-Dev-Core/${repo}/main/docs/screenshots/${file}`;
const shots = [
  { src: raw("astiko-ktel-kastorias-app", "el-stop.png") },
  { src: raw("astiko-ktel-kastorias-ios", "el-map-line.png") },
  { src: raw("astiko-ktel-kastorias-app", "el-home.png") },
];
---

<Base lang={lang}>
  <Header lang={lang} otherHref={s.nav.otherHref} showLog={!!activity} />

  <main>
    <section class="bg-navy text-white">
      <div class="mx-auto grid max-w-6xl gap-10 px-5 pt-16 pb-14 lg:grid-cols-12 lg:gap-8 lg:pt-24 lg:pb-20">
        <div class="lg:col-span-5 lg:pt-6">
          <p class="font-mono text-xs tracking-wide text-orange">40.52°N 21.26°E · Καστοριά</p>
          <h1 class="mt-5 text-4xl leading-[1.05] font-[750] tracking-[-0.03em] text-balance sm:text-5xl">
            {s.intro}
          </h1>
          <p class="mt-6 max-w-md text-lg leading-relaxed text-white/70">{s.introMore}</p>
          <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm">
            <a href="#work" class="rounded-md bg-orange px-4 py-2.5 font-semibold text-navy hover:bg-[#ffb13b]">{s.work} ↓</a>
            <a href={gh} class="font-medium text-white/80 underline decoration-white/30 underline-offset-4 hover:text-white">github.com/Kastoria-Dev-Core</a>
          </div>
        </div>
        <div class="lg:col-span-7">
          {
            network && (
              <>
                <NetworkMap map={network} label={s.mapCaption(network.lines.length, network.stopCount)} />
                <p class="mt-3 max-w-lg font-mono text-[11px] leading-relaxed text-white/45">
                  {s.mapCaption(network.lines.length, network.stopCount)}
                </p>
              </>
            )
          }
        </div>
      </div>
    </section>

    <section id="work" class="mx-auto max-w-6xl px-5 py-20 lg:py-28">
      <div class="grid gap-6 lg:grid-cols-12">
        <h2 class="text-3xl font-[750] tracking-[-0.02em] lg:col-span-4">{s.work}</h2>
        <p class="text-ink-soft lg:col-span-6 lg:pt-2">{s.workLead}</p>
      </div>

      <article class="mt-12 grid overflow-hidden rounded-2xl border border-rule bg-paper-2 lg:grid-cols-12">
        <div class="flex flex-col p-7 sm:p-10 lg:col-span-6">
          <img src="/icon-buses.png" alt="" width="64" height="64" class="h-16 w-16" />
          <h3 class="mt-6 text-2xl font-[750] tracking-[-0.02em] sm:text-3xl">{s.buses.name}</h3>
          <p class="mt-3 max-w-lg leading-relaxed text-ink-soft">{s.buses.text}</p>
          <ul class="mt-auto divide-y divide-rule border-y border-rule pt-0 lg:mt-10">
            {
              platforms.map((pl) => (
                <li class="grid grid-cols-[6.5rem_1fr_auto] items-baseline gap-4 py-3.5 font-mono text-xs">
                  <span class="font-sans text-sm font-semibold">{pl.label}</span>
                  {pl.release ? (
                    <a href={pl.release.url} class="text-ink hover:underline" data-release={pl.repo}>
                      {pl.release.tag} · {date(pl.release.date)}
                    </a>
                  ) : (
                    <span class="text-ink-soft">{pl.note}</span>
                  )}
                  <span class="flex justify-end gap-4 text-ink-soft">
                    <a href={`${gh}/${pl.repo}`} class="hover:text-ink hover:underline">GitHub ↗</a>
                    {pl.docs && <a href={pl.docs} class="hover:text-ink hover:underline">Docs ↗</a>}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="relative flex min-h-80 items-end justify-center gap-3 overflow-hidden bg-navy px-6 pt-10 sm:gap-5 lg:col-span-6" aria-hidden="true">
          {
            shots.map((shot, i) => (
              <img
                src={shot.src}
                alt=""
                loading="lazy"
                width="430"
                height="935"
                class={`w-[30%] max-w-[190px] rounded-t-[20px] border border-b-0 border-white/10 shadow-[0_20px_50px_-10px_rgb(0_0_0/0.5)] ${i === 1 ? "translate-y-0" : "translate-y-8"}`}
              />
            ))
          }
        </div>
      </article>

      <div class="mt-6 grid gap-6">
        {
          others.map((o) => (
            <article class="grid items-center gap-x-8 gap-y-4 rounded-2xl border border-rule p-7 sm:p-8 md:grid-cols-12">
              <div class="flex items-center gap-4 md:col-span-4">
                <img src={o.icon} alt="" width="56" height="56" class="h-14 w-14 rounded-[14px]" />
                <div>
                  <h3 class="text-xl font-semibold tracking-tight">{s.projects[o.key].name}</h3>
                  <p class="font-mono text-xs text-ink-soft">{o.tech}</p>
                </div>
              </div>
              <p class="leading-relaxed text-ink-soft md:col-span-5">{s.projects[o.key].text}</p>
              <div class="flex flex-wrap gap-x-5 gap-y-1 font-mono text-xs md:col-span-3 md:flex-col md:items-end">
                {o.release && (
                  <a href={o.release.url} class="text-ink hover:underline" data-release={o.repo}>
                    {o.release.tag} · {date(o.release.date)}
                  </a>
                )}
                <a href={`${gh}/${o.repo}`} class="text-ink-soft hover:text-ink hover:underline">GitHub ↗</a>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    {
      activity && activity.recent.length > 0 && (
        <section id="log" class="mx-auto max-w-6xl px-5 py-20 lg:py-28">
          <div class="grid gap-6 lg:grid-cols-12">
            <h2 class="text-3xl font-[750] tracking-[-0.02em] lg:col-span-4">{s.log}</h2>
            <p class="text-ink-soft lg:col-span-6 lg:pt-2">{s.logLead(activity.totalMerged)}</p>
          </div>
          <ul class="mt-10 divide-y divide-rule border-y border-rule">
            {activity.recent.map((pr) => (
              <li>
                <a href={pr.url} class="group grid gap-x-6 gap-y-1 py-3.5 sm:grid-cols-[5rem_15rem_1fr]">
                  <span class="font-mono text-xs text-ink-soft sm:pt-0.5">{shortDate(pr.date)}</span>
                  <span class="truncate font-mono text-xs text-ink-soft sm:pt-0.5">
                    {pr.repo}#{pr.number}
                  </span>
                  <span class="group-hover:underline">{pr.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section id="team" class="border-t border-rule">
      <div class="mx-auto grid max-w-6xl gap-10 px-5 py-20 lg:grid-cols-12 lg:py-28">
        <div class="lg:col-span-4">
          <h2 class="text-3xl font-[750] tracking-[-0.02em]">{s.team}</h2>
          <p class="mt-4 text-ink-soft">{s.teamLead}</p>
        </div>
        <ul class="space-y-5 lg:col-span-8">
          {
            team.map((m) => (
              <li>
                <a href={`https://github.com/${m.login}`} class="group flex items-center gap-4">
                  <img src={`https://avatars.githubusercontent.com/${m.login}?s=96`} alt="" width="40" height="40" loading="lazy" class="rounded-full ring-1 ring-rule" />
                  <span class="text-xl font-semibold tracking-tight group-hover:underline sm:text-2xl">{m[lang]}</span>
                  <span class="font-mono text-xs text-ink-soft">@{m.login}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section id="join" class="bg-orange text-navy">
      <div class="mx-auto grid max-w-6xl gap-8 px-5 py-16 lg:grid-cols-12 lg:py-20">
        <h2 class="text-3xl font-[750] tracking-[-0.02em] lg:col-span-4">{s.join}</h2>
        <div class="lg:col-span-8">
          <p class="max-w-2xl text-lg leading-relaxed">{s.joinText}</p>
          <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 font-semibold">
            <a href={`${gh}/.github/blob/main/CONTRIBUTING.md`} class="underline decoration-navy/40 underline-offset-4 hover:decoration-navy">{s.joinLink} →</a>
            <a href={`${gh}?tab=repositories`} class="underline decoration-navy/40 underline-offset-4 hover:decoration-navy">{s.reposLink} →</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />

  <script is:inline define:vars={{ dateLocale: s.dateLocale }}>
    // The latest release of each app, asked of GitHub when the page opens, so a release made since the
    // last build shows at once. The version from the build stays if GitHub doesn't answer.
    for (const link of document.querySelectorAll("[data-release]")) {
      fetch(`https://api.github.com/repos/Kastoria-Dev-Core/${link.dataset.release}/releases/latest`, {
        headers: { Accept: "application/vnd.github+json" },
      })
        .then((res) => (res.ok ? res.json() : null))
        .then((r) => {
          if (!r || !r.tag_name) return;
          const when = new Date(r.published_at).toLocaleDateString(dateLocale, { day: "numeric", month: "short", year: "numeric", timeZone: "Europe/Athens" });
          link.textContent = `${r.tag_name} · ${when}`;
          link.href = r.html_url;
        })
        .catch(() => {});
    }
  </script>
</Base>
