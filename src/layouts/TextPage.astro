---
import Base from "./Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import type { Lang } from "../lib/i18n";

interface Props {
  lang: Lang;
  title: string;
  /** The same page in the other language */
  otherHref: string;
  /** "Last updated …" under the title */
  updated?: string;
}
const { lang, title, otherHref, updated } = Astro.props;
---

<Base lang={lang} title={title}>
  <Header lang={lang} otherHref={otherHref} />
  <main class="mx-auto max-w-3xl px-5 py-16 lg:py-24">
    <h1 class="text-4xl leading-tight font-[750] tracking-[-0.03em]">{title}</h1>
    {updated && <p class="mt-3 font-mono text-xs text-ink-soft">{updated}</p>}
    <div
      class="mt-10 space-y-5 leading-relaxed text-ink-soft [&_a]:text-ink [&_a]:underline [&_a]:decoration-rule [&_a]:underline-offset-4 hover:[&_a]:decoration-ink [&_h2]:pt-6 [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:tracking-tight [&_h2]:text-ink [&_li]:ml-5 [&_li]:list-disc [&_strong]:text-ink"
    >
      <slot />
    </div>
  </main>
  <Footer lang={lang} />
</Base>
