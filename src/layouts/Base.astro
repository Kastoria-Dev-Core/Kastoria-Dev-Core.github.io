---
import "@fontsource-variable/commissioner";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import type { Lang } from "../lib/i18n";
import { t } from "../lib/i18n";

interface Props {
  lang: Lang;
  /** The page's own title, before the site's name; none on the home page */
  title?: string;
}
const { lang, title } = Astro.props;
const s = t[lang];
const pageTitle = title ? `${title} · ${s.title}` : s.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
// The same page in the other language: /en/x/ <-> /x/
const elPath = Astro.url.pathname.replace(/^\/en(\/|$)/, "/");
const enPath = elPath === "/" ? "/en/" : `/en${elPath}`;
---

<!doctype html>
<html lang={s.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={s.description} />
    <meta name="theme-color" content="#13283f" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="el" href={new URL(elPath, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site)} />
    <link rel="icon" href="/logo-mark.svg" type="image/svg+xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={s.description} />
    <meta property="og:image" content={new URL("/social-preview.png", Astro.site)} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
  </body>
</html>
