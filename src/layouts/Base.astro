---
import "@fontsource-variable/commissioner";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import type { Lang } from "../lib/i18n";
import { t } from "../lib/i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t[lang];
const canonical = new URL(lang === "el" ? "/" : "/en/", Astro.site);
---

<!doctype html>
<html lang={s.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{s.title}</title>
    <meta name="description" content={s.description} />
    <meta name="theme-color" content="#13283f" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="el" href={new URL("/", Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL("/en/", Astro.site)} />
    <link rel="icon" href="/logo-mark.svg" type="image/svg+xml" />
    <meta property="og:title" content={s.title} />
    <meta property="og:description" content={s.description} />
    <meta property="og:image" content={new URL("/social-preview.png", Astro.site)} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
  </body>
</html>
